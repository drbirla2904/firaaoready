[Unit]
Description=Firaao daily reminders, payouts, and retention check
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=firaao
Group=firaao
SupplementaryGroups=www-data
WorkingDirectory=/srv/firaao/looprewards
EnvironmentFile=/srv/firaao/looprewards/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash /srv/firaao/looprewards/deploy/run-daily-jobs.sh
