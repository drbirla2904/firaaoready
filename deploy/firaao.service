[Unit]
Description=Firaao Django application
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=firaao
Group=firaao
SupplementaryGroups=www-data
WorkingDirectory=/srv/firaao/looprewards
EnvironmentFile=/srv/firaao/looprewards/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/firaao/looprewards/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:${APP_BIND_PORT} --workers ${WEB_WORKERS} --worker-class gthread --threads 4 --timeout 60 --max-requests 2000 --max-requests-jitter 200 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/srv/firaao/looprewards/media /srv/firaao/looprewards/private-media

[Install]
WantedBy=multi-user.target
