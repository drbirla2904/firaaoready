# Copy to .env on the server and replace every CHANGE value.
DEBUG=0
SECRET_KEY=CHANGE-use-openssl-rand-hex-32
DOMAIN=firaao.shop
ALLOWED_HOSTS=firaao.shop,www.firaao.shop
BASE_URL=https://firaao.shop
CSRF_TRUSTED_ORIGINS=https://firaao.shop,https://www.firaao.shop
SECURE_SSL_REDIRECT=1
NUM_PROXIES=1
WEB_WORKERS=2
APP_BIND_PORT=18080
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
MEDIA_ROOT=/srv/firaao/looprewards/media
SENTRY_DSN=
POSTGRES_DB=firaao
POSTGRES_USER=firaao
POSTGRES_PASSWORD=CHANGE-use-a-long-random-password
# Razorpay test mode: use your account's Test Mode API keys (Dashboard > Settings > API Keys).
# Test key IDs begin rzp_test_. Enter the actual values from Razorpay; never commit secrets.
# Webhook: https://DOMAIN/api/billing/webhook/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay Plan IDs are OPTIONAL now: leave blank and Firaao creates the monthly/yearly plans itself the first time AutoPay is used
# (or run: python manage.py sync_razorpay_plans). Only set these if you want to reuse plans you already made in the dashboard.
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
# our own UPI QR/ID for manual payments
PLATFORM_UPI_ID=
PLATFORM_UPI_NAME=Firaao
# GST invoice header
GST_RATE=18
SELLER_NAME="CHANGE-your-legal-business-name"
# Replace with the actual GSTIN, or leave empty if not applicable.
SELLER_GSTIN=CHANGE-your-GSTIN-or-leave-empty-if-not-applicable
SELLER_ADDRESS="CHANGE-your-registered-business-address"
# SMS/WhatsApp bridge (POST {"mobile","text"}); empty = log only
NOTIFY_WEBHOOK_URL=
NOTIFY_SMS=0
COMMISSION_FIRST_YEAR_ONLY=0
# Optional offsite backups: an rclone remote, e.g. contabo:looprewards-backups
RCLONE_REMOTE=
# legal pages (shown on /privacy /terms /refund /contact) - set real values before launch
SUPPORT_EMAIL=support@firaao.shop
SUPPORT_PHONE=
GRIEVANCE_NAME="Grievance Officer"
GRIEVANCE_EMAIL=grievance@firaao.shop
JURISDICTION="Mumbai, Maharashtra"
LEGAL_UPDATED=CHANGE-legal-review-date
HOSTING_REGION="CHANGE-Contabo actual data-centre region"
# data kept this many months after a shop's plan + pause ends; AUTO_PURGE=1 lets the daily job delete it (default: dry-run only)
RETENTION_MONTHS=12
AUTO_PURGE=0

# Partner payouts: TDS rate in percent (0 = off) and yearly threshold in paise. Confirm values with your accountant.
VENDOR_TDS_RATE=0
VENDOR_TDS_THRESHOLD_PAISE=0
# Let shop owners join the refer-and-earn wallet without admin approval (1 = instant, 0 = admin approves)
OWNER_REFERRAL_AUTO_APPROVE=0
